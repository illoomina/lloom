# Generated by Cargo
# will have compiled files and executables
debug/
data/
dist/
target/

# Cargo.lock is tracked: lloom ships binaries, and the gates build --locked
# (CONTRIBUTING §3.1e). `cargo update` is a reviewed change, not a side effect.

# editor config
.helix
.vscode
.zed

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

*tokenizer*.json
*.npz

perf.data
flamegraph.svg
*.dylib
*.so
*.swp
*.swo
trace-*.json

candle-wasm-examples/*/build
candle-wasm-examples/*/*.bin
candle-wasm-examples/*/*.jpeg
candle-wasm-examples/*/audios/*.wav
candle-wasm-examples/**/*.safetensors
candle-wasm-examples/**/*.gguf
candle-wasm-examples/*/package-lock.json
candle-wasm-examples/**/config*.json
.DS_Store
.idea/*
__pycache__
out.safetensors
out.wav
bria.mp3
bria.safetensors
bria.wav
bench_results/

# Build dirs used by agents with a custom CARGO_TARGET_DIR
target-*/
